---
// Posts live at the same URLs the old Jekyll site used: /YYYY/MM/DD/Slug.html
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { getPosts, formatDate, type Post } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const [year, month, day] = post.url.split('/').slice(1, 4);
    return {
      params: { year, month, day, slug: post.slug },
      props: { post, newer: posts[i - 1], older: posts[i + 1] },
    };
  });
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.subtitle} type="article">
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.date.toISOString().slice(0, 10)}>
          {formatDate(post.date, { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {post.data.subtitle && <> · {post.data.subtitle}</>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <nav class="post-nav" aria-label="More posts">
    {older && <a class="prev" href={older.url}>← {older.data.title}</a>}
    {newer && <a class="next" href={newer.url}>{newer.data.title} →</a>}
  </nav>
</Base>
