---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, groupByYear } from '../lib/posts';

const years = groupByYear(await getPosts(), (p) => p.date.getUTCFullYear());
---
<Base title="Writing" description="Occasional posts by William Zijie Zhang.">
  <h1>Writing</h1>
  <p class="lede">Occasional notes on optimization, open source, school and life. <a href="/feed.xml">RSS</a>.</p>
  {years.map(([year, posts]) => (
    <section>
      <h2 class="year">{year}</h2>
      <PostList posts={posts} />
    </section>
  ))}
</Base>
